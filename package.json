{
  "name": "dsh-voice-input-deepseek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek official speech-to-text dictation for the composer, with a live recording-time / limit readout.",
  "license": "MIT",
  "author": {
    "name": "QsmyHyly",
    "url": "https://space.bilibili.com/1525999910"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "speech-to-text",
    "asr",
    "voice-input",
    "dictation"
  ],
  "homepage": "https://github.com/QsmyHyly/dsh-voice-input-deepseek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QsmyHyly/dsh-voice-input-deepseek.git"
  },
  "bugs": {
    "url": "https://github.com/QsmyHyly/dsh-voice-input-deepseek/issues"
  },
  "scripts": {
    "test": "node test/host-route.test.mjs && node test/client-render.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
